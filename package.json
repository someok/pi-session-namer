{
  "name": "@someok/pi-session-namer",
  "version": "0.4.1",
  "description": "Automatically name and update Pi sessions from the current conversation",
  "type": "module",
  "license": "MIT",
  "author": "someok",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/someok/pi-session-namer.git"
  },
  "bugs": {
    "url": "https://github.com/someok/pi-session-namer/issues"
  },
  "homepage": "https://github.com/someok/pi-session-namer#readme",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "session",
    "session-name",
    "auto-naming",
    "naming"
  ],
  "engines": {
    "node": ">=20"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "changelogPath": "CHANGELOG.md"
  },
  "files": [
    "src/index.ts",
    "session-namer.example.json",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "tsc --outDir .tmp-test --noEmit false && node --test .tmp-test/test/*.test.js"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=0.84.0",
    "@earendil-works/pi-coding-agent": ">=0.84.0"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^1.5.0",
    "@earendil-works/pi-coding-agent": "^1.5.0",
    "@types/node": "^26.4.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
